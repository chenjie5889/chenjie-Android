<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂无健康档案"
            android:textColor="#94A3B8" />
        <TextView
            android:id="@+id/tvGoFill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="立即创建档案"
            android:textColor="#3B82F6"
            android:textSize="18sp"
            android:layout_marginTop="12dp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="个人健康档案"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"/>
                <TextView
                    android:id="@+id/btnEditTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="修改信息"
                    android:textColor="#3B82F6"
                    android:textStyle="bold"
                    android:visibility="visible" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/containerEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <EditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="真实姓名"
                            android:background="@null"
                            android:enabled="false" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F1F5F9"/>
                        <RadioGroup
                            android:id="@+id/rgGender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="10dp">
                            <RadioButton
                                android:id="@+id/rbMale"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="男" />
                            <RadioButton
                                android:id="@+id/rbFemale"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="女"
                                android:layout_marginStart="30dp" />
                        </RadioGroup>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F1F5F9"/>
                        <EditText
                            android:id="@+id/etBirthday"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="生日 (格式: 1995-05-20)"
                            android:inputType="date"
                            android:enabled="true" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F1F5F9"/>
                        <EditText
                            android:id="@+id/etHeight"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="身高 (cm)"
                            android:inputType="numberDecimal"
                            android:background="@null" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F1F5F9"/>
                        <EditText
                            android:id="@+id/etWeight"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="体重 (kg)"
                            android:inputType="numberDecimal"
                            android:background="@null" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="病史描述"
                    android:layout_marginTop="16dp"
                    android:textStyle="bold"
                    android:textColor="#475569"/>
                <EditText
                    android:id="@+id/etHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="5"
                    android:layout_marginTop="8dp"
                    android:padding="12dp"
                    android:hint="请详细描述既往病史、过敏史等..."
                    android:gravity="top" />
                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="保存档案"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="#3B82F6"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:background="@drawable/bg_medical_record"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="基本体征"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:textSize="18sp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#0F172A"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"/>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2">
                    <TextView
                        android:id="@+id/viewName"
                        android:layout_width="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="姓名：加载中..."
                        android:textSize="16sp"
                        android:layout_columnWeight="1"/>
                    <TextView
                        android:id="@+id/viewGender"
                        android:layout_width="wrap_content"
                        android:text="性别：加载中..."
                        android:textSize="16sp"
                        android:layout_columnWeight="1"/>
                    <TextView
                        android:id="@+id/viewBirthday"
                        android:layout_width="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="生日：加载中..."
                        android:textSize="16sp"
                        android:layout_columnWeight="1"/>
                    <TextView
                        android:id="@+id/viewBMI"
                        android:layout_width="wrap_content"
                        android:text="体征：加载中..."
                        android:textSize="16sp"
                        android:layout_columnWeight="1"/>
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="临床史/既往症"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:textColor="#0F172A" />
                <View
                    android:layout_width="40dp"
                    android:layout_height="1dp"
                    android:background="#94A3B8"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/viewHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="加载中..."
                    android:lineSpacingExtra="4dp"
                    android:textColor="#334155"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="30dp"
                    android:text="—— 个人健康记录存档 ——"
                    android:textSize="12sp"
                    android:textColor="#CBD5E1"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>