<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="疾病名称 *"
            android:layout_marginBottom="4dp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etDiseaseName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="如：高血压、糖尿病"
            android:background="#F3F4F6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="疾病类型"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etDiseaseType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="如：原发性、继发性"
            android:background="#F3F4F6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="确诊日期"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etDiagnosisDate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="格式：YYYY-MM-DD"
            android:inputType="date"
            android:background="#F3F4F6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="确诊医院"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etHospital"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="输入医院名称"
            android:background="#F3F4F6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="主治医生"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etDoctor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="输入医生姓名"
            android:background="#F3F4F6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="诊断信息"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etDiagnosisInfo"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="详细描述诊断结果"
            android:gravity="top"
            android:background="#F3F4F6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="症状描述"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etSymptoms"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="详细描述症状表现"
            android:gravity="top"
            android:background="#F3F4F6" />

    </LinearLayout>
</ScrollView>